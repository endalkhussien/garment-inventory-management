# =============================================================================
# Copy to .env for LOCAL use only. Never commit .env.
# Vercel does NOT read this file — set the same keys in:
#   Vercel → Project → Settings → Environment Variables
# =============================================================================

# --- DATABASE (required) ---
# LOCAL (Docker Compose):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/garment_inventory?schema=public"
#
# PRODUCTION / Vercel: Neon pooled URL (must NOT be localhost)
DATABASE_URL="postgresql://USER:PASSWORD@ep-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=30&pgbouncer=true&pool_timeout=30"

# --- AUTH (required) ---
# LOCAL:  NEXTAUTH_URL="http://localhost:3000"
# PROD:   exact site URL
NEXTAUTH_URL="https://YOUR-APP.vercel.app"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET="replace-with-a-long-random-string"
